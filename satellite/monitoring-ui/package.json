{
  "name": "@luml/satellite-monitoring-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Satellite-hosted monitoring dashboard SPA, served by the Agent into the Platform iframe.",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@luml/design-tokens": "*",
    "@primevue/themes": "^4.3.9",
    "@vueuse/core": "^14.1.0",
    "apexcharts": "^5.10.6",
    "axios": "^1.20.0",
    "lucide-vue-next": "^0.460.0",
    "pinia": "^2.2.6",
    "primevue": "^4.4.1",
    "vue": "^3.5.12",
    "vue3-apexcharts": "^1.8.0"
  }
}
