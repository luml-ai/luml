{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "podSecurity": {
      "type": "object",
      "properties": {
        "preset": {
          "enum": [
            "vanilla",
            "openshift"
          ]
        }
      }
    },
    "sidecar": {
      "type": "object",
      "properties": {
        "cacheTtlSeconds": {
          "type": "number",
          "exclusiveMinimum": 15
        },
        "staleAllowanceSeconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "gpu": {
      "type": "object",
      "properties": {
        "maximumCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "resourceNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "store": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "standalone",
                "external"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    },
    "sharedCache": {
      "type": "object",
      "properties": {
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "probes": {
      "type": "object",
      "properties": {
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiServerPort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    }
  }
}
