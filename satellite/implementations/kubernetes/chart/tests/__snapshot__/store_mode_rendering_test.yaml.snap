                - name: GREPTIMEDB_HTTP_PORT
                  value: "4444"
                - name: GREPTIMEDB_DATABASE
                  value: luml
                - name: GREPTIMEDB_USERNAME
                  valueFrom:
                    secretKeyRef:
                      key: username
                      name: store-mode-luml-satellite-kubernetes-store-credentials
                - name: GREPTIMEDB_PASSWORD
                  valueFrom:
                    secretKeyRef:
                      key: password
                      name: store-mode-luml-satellite-kubernetes-store-credentials
                - name: SIDECAR_INTERNAL_URL_TEMPLATE
                  value: http://luml-dep-{deployment_id}:8001
                - name: MONITORING_FRAME_ANCESTORS
                  value: ""
                - name: MONITORING_SESSION_TTL_SECONDS
                  value: "1800"
                - name: MONITORING_DEPLOYMENTS_REFRESH_SEC
                  value: "60"
                - name: MONITORING_INTERVAL_SEC
                  value: "60"
                - name: MONITORING_WINDOW_SEC
                  value: "300"
                - name: MONITORING_BACKFILL_MAX_WINDOWS
                  value: "12"
                - name: MONITORING_EVENTS_TTL
                  value: 30d
                - name: MONITORING_RESULTS_TTL
                  value: 30d
                - name: MONITORING_ALERTS_TTL
                  value: 30d
                - name: MONITORING_TRACES_TTL
                  value: 30d
                - name: MONITORING_METRICS_TTL
                  value: 7d
                - name: LOG_LEVEL
                  value: info
                - name: AGENT_PORT
                  value: "8000"
              image: ghcr.io/luml-ai/luml-satellite-monitoring:dev
              imagePullPolicy: IfNotPresent
              livenessProbe:
                httpGet:
                  path: /livez
                  port: http
                periodSeconds: 10
              name: dashboard
              ports:
                - containerPort: 8000
                  name: http
              readinessProbe:
                httpGet:
                  path: /livez
                  port: http
                periodSeconds: 5
              resources: {}
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                runAsNonRoot: true
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
          securityContext:
            fsGroup: 10001
            runAsGroup: 0
            runAsNonRoot: true
            runAsUser: 10001
            seccompProfile:
              type: RuntimeDefault
          volumes:
            - emptyDir: {}
              name: tmp
