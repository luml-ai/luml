    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      labels:
        app.kubernetes.io/component: network-policy
        app.kubernetes.io/instance: store-mode
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: luml-satellite-kubernetes
        app.kubernetes.io/version: 0.1.0
        helm.sh/chart: luml-satellite-kubernetes-0.1.0
        luml.ai/satellite-id: store-mode
      name: store-mode-luml-satellite-kubernetes
    spec:
      egress:
        - to:
            - podSelector:
                matchLabels:
                  luml.ai/satellite-id: store-mode
        - ports:
            - port: 53
              protocol: UDP
            - port: 53
              protocol: TCP
        - ports:
            - port: 80
              protocol: TCP
            - port: 443
              protocol: TCP
        - ports:
            - port: 4444
              protocol: TCP
      ingress:
        - from:
            - podSelector:
                matchLabels:
                  luml.ai/satellite-id: store-mode
        - ports:
            - port: 8000
              protocol: TCP
      podSelector:
        matchLabels:
          luml.ai/satellite-id: store-mode
      policyTypes:
        - Ingress
        - Egress
