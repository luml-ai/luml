changes only the external store boundary:
  1: |
    apiVersion: v1
    data:
      config.yaml: |
        receivers:
          otlp:
            protocols:
              grpc:
                endpoint: 0.0.0.0:4317
        extensions:
          basicauth/client:
            client_auth:
              username: ${env:GREPTIMEDB_USERNAME}
              password: ${env:GREPTIMEDB_PASSWORD}
        exporters:
          otlphttp/traces:
            endpoint: "http://greptime.example.test:4444/v1/otlp"
            tls:
              insecure: true
            auth:
              authenticator: basicauth/client
            headers:
              x-greptime-db-name: "luml"
              x-greptime-trace-table-name: otel_traces
          otlphttp/events:
            endpoint: "http://greptime.example.test:4444/v1/otlp"
            tls:
              insecure: true
            auth:
              authenticator: basicauth/client
            headers:
              x-greptime-db-name: "luml"
              x-greptime-trace-table-name: inference_events
        processors:
          filter/traces_main:
            error_mode: ignore
            traces:
              span:
                - 'resource.attributes["service.name"] == "satellite-agent.events"'
          filter/traces_events:
            error_mode: ignore
            traces:
              span:
                - 'resource.attributes["service.name"] != "satellite-agent.events"'
        service:
          extensions: [basicauth/client]
          pipelines:
            traces/main:
              receivers: [otlp]
              processors: [filter/traces_main]
              exporters: [otlphttp/traces]
            traces/events:
              receivers: [otlp]
              processors: [filter/traces_events]
              exporters: [otlphttp/events]
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/component: collector
        app.kubernetes.io/instance: store-mode
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: luml-satellite-kubernetes
        app.kubernetes.io/version: 0.1.0
        helm.sh/chart: luml-satellite-kubernetes-0.1.0
        luml.ai/satellite-id: store-mode
      name: store-mode-luml-satellite-kubernetes-collector
  2: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/component: collector
        app.kubernetes.io/instance: store-mode
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: luml-satellite-kubernetes
        app.kubernetes.io/version: 0.1.0
        helm.sh/chart: luml-satellite-kubernetes-0.1.0
        luml.ai/satellite-id: store-mode
      name: store-mode-luml-satellite-kubernetes-collector
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/component: collector
          app.kubernetes.io/instance: store-mode
          app.kubernetes.io/name: luml-satellite-kubernetes
          luml.ai/satellite-id: store-mode
      template:
        metadata:
          labels:
            app.kubernetes.io/component: collector
            app.kubernetes.io/instance: store-mode
            app.kubernetes.io/name: luml-satellite-kubernetes
            luml.ai/satellite-id: store-mode
        spec:
          automountServiceAccountToken: false
          containers:
            - args:
                - --config=/etc/otel/config.yaml
              env:
                - name: GREPTIMEDB_USERNAME
                  valueFrom:
                    secretKeyRef:
                      key: username
                      name: store-mode-luml-satellite-kubernetes-store-credentials
                - name: GREPTIMEDB_PASSWORD
                  valueFrom:
                    secretKeyRef:
                      key: password
                      name: store-mode-luml-satellite-kubernetes-store-credentials
              image: otel/opentelemetry-collector-contrib:0.127.0
              imagePullPolicy: IfNotPresent
              livenessProbe:
                periodSeconds: 10
                tcpSocket:
                  port: otlp-grpc
              name: collector
              ports:
                - containerPort: 4317
                  name: otlp-grpc
              readinessProbe:
                periodSeconds: 5
                tcpSocket:
                  port: otlp-grpc
              resources: {}
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                runAsNonRoot: true
              volumeMounts:
                - mountPath: /etc/otel
                  name: config
                  readOnly: true
                - mountPath: /tmp
                  name: tmp
          securityContext:
            fsGroup: 10001
            runAsGroup: 0
            runAsNonRoot: true
            runAsUser: 10001
            seccompProfile:
              type: RuntimeDefault
          volumes:
            - configMap:
                name: store-mode-luml-satellite-kubernetes-collector
              name: config
            - emptyDir: {}
              name: tmp
  3: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/component: dashboard
        app.kubernetes.io/instance: store-mode
        app.kubernetes.io/managed-by: Helm
