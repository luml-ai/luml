            app.kubernetes.io/instance: store-mode
            app.kubernetes.io/name: luml-satellite-kubernetes
            luml.ai/satellite-id: store-mode
        spec:
          automountServiceAccountToken: false
          containers:
            - command:
                - luml-monitoring-dashboard
              env:
                - name: SATELLITE_TOKEN
                  valueFrom:
                    secretKeyRef:
                      key: satellite-token
                      name: store-mode-luml-satellite-kubernetes-token
                - name: DERIVATION_KEY
                  valueFrom:
                    secretKeyRef:
                      key: derivation-key
                      name: store-mode-luml-satellite-kubernetes-derivation-key
                - name: PLATFORM_URL
