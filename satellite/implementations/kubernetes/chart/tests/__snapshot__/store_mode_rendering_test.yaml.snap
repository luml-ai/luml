                - name: SIDECAR_INTERNAL_URL_TEMPLATE
                  value: http://luml-dep-{deployment_id}:8001
                - name: MONITORING_FRAME_ANCESTORS
                  value: ""
                - name: MONITORING_SESSION_TTL_SECONDS
                  value: "1800"
                - name: MONITORING_DEPLOYMENTS_REFRESH_SEC
                  value: "60"
                - name: MONITORING_INTERVAL_SEC
                  value: "60"
                - name: MONITORING_WINDOW_SEC
                  value: "300"
                - name: MONITORING_BACKFILL_MAX_WINDOWS
                  value: "12"
                - name: MONITORING_EVENTS_TTL
                  value: 30d
                - name: MONITORING_RESULTS_TTL
                  value: 30d
                - name: MONITORING_ALERTS_TTL
                  value: 30d
                - name: MONITORING_TRACES_TTL
                  value: 30d
                - name: MONITORING_METRICS_TTL
                  value: 7d
                - name: LOG_LEVEL
                  value: info
                - name: MONITORING_HEARTBEAT_FILE
                  value: /var/run/luml-monitoring/heartbeat
              image: ghcr.io/luml-ai/luml-satellite-monitoring:dev
              imagePullPolicy: IfNotPresent
              livenessProbe:
                exec:
                  command:
                    - luml-monitoring-worker
                    - --probe
                initialDelaySeconds: 180
                periodSeconds: 60
              name: worker
              resources: {}
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                runAsNonRoot: true
              volumeMounts:
                - mountPath: /var/run/luml-monitoring
                  name: heartbeat
                - mountPath: /tmp
                  name: tmp
          securityContext:
            fsGroup: 10001
            runAsGroup: 0
            runAsNonRoot: true
            runAsUser: 10001
            seccompProfile:
              type: RuntimeDefault
          volumes:
            - emptyDir: {}
              name: heartbeat
            - emptyDir: {}
              name: tmp
  5: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      labels:
        app.kubernetes.io/component: network-policy
        app.kubernetes.io/instance: store-mode
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: luml-satellite-kubernetes
        app.kubernetes.io/version: 0.1.0
        helm.sh/chart: luml-satellite-kubernetes-0.1.0
        luml.ai/satellite-id: store-mode
      name: store-mode-luml-satellite-kubernetes
    spec:
      egress:
        - to:
            - podSelector:
                matchLabels:
                  luml.ai/satellite-id: store-mode
        - ports:
            - port: 53
              protocol: UDP
            - port: 53
              protocol: TCP
        - ports:
            - port: 80
              protocol: TCP
            - port: 443
              protocol: TCP
      ingress:
        - from:
            - podSelector:
                matchLabels:
                  luml.ai/satellite-id: store-mode
        - ports:
            - port: 8000
              protocol: TCP
      podSelector:
        matchLabels:
          luml.ai/satellite-id: store-mode
      policyTypes:
        - Ingress
        - Egress
  6: |
    apiVersion: v1
    kind: Service
    metadata:
      labels:
        app.kubernetes.io/component: store
        app.kubernetes.io/instance: store-mode
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: luml-satellite-kubernetes
        app.kubernetes.io/version: 0.1.0
        helm.sh/chart: luml-satellite-kubernetes-0.1.0
        luml.ai/satellite-id: store-mode
      name: store-mode-luml-satellite-kubernetes-store
    spec:
      ports:
        - name: http
          port: 4000
          targetPort: http
        - name: grpc
          port: 4001
          targetPort: grpc
      selector:
        app.kubernetes.io/component: store
        app.kubernetes.io/instance: store-mode
        app.kubernetes.io/name: luml-satellite-kubernetes
        luml.ai/satellite-id: store-mode
      type: ClusterIP
  7: |
    apiVersion: apps/v1
    kind: StatefulSet
    metadata:
      labels:
        app.kubernetes.io/component: store
        app.kubernetes.io/instance: store-mode
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: luml-satellite-kubernetes
        app.kubernetes.io/version: 0.1.0
        helm.sh/chart: luml-satellite-kubernetes-0.1.0
        luml.ai/satellite-id: store-mode
      name: store-mode-luml-satellite-kubernetes-store
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/component: store
          app.kubernetes.io/instance: store-mode
          app.kubernetes.io/name: luml-satellite-kubernetes
          luml.ai/satellite-id: store-mode
      serviceName: store-mode-luml-satellite-kubernetes-store
      template:
        metadata:
          labels:
            app.kubernetes.io/component: store
            app.kubernetes.io/instance: store-mode
            app.kubernetes.io/name: luml-satellite-kubernetes
            luml.ai/satellite-id: store-mode
        spec:
          automountServiceAccountToken: false
          containers:
            - args:
                - standalone
                - start
                - --http-addr=0.0.0.0:4000
                - --rpc-addr=0.0.0.0:4001
              image: greptime/greptimedb:v0.13.1
              imagePullPolicy: IfNotPresent
              livenessProbe:
                periodSeconds: 10
                tcpSocket:
                  port: http
              name: store
              ports:
                - containerPort: 4000
                  name: http
                - containerPort: 4001
                  name: grpc
              readinessProbe:
                periodSeconds: 5
                tcpSocket:
                  port: http
              resources: {}
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                runAsNonRoot: true
              volumeMounts:
                - mountPath: /tmp/greptimedb
                  name: data
                - mountPath: /tmp/runtime
                  name: tmp
          securityContext:
            fsGroup: 10001
            runAsGroup: 0
            runAsNonRoot: true
            runAsUser: 10001
            seccompProfile:
              type: RuntimeDefault
          volumes:
            - emptyDir: {}
              name: tmp
      volumeClaimTemplates:
        - metadata:
            labels:
              app.kubernetes.io/component: store
              app.kubernetes.io/instance: store-mode
              app.kubernetes.io/managed-by: Helm
              app.kubernetes.io/name: luml-satellite-kubernetes
              app.kubernetes.io/version: 0.1.0
              helm.sh/chart: luml-satellite-kubernetes-0.1.0
              luml.ai/satellite-id: store-mode
            name: data
          spec:
            accessModes:
              - ReadWriteOnce
            resources:
              requests:
                storage: 20Gi
