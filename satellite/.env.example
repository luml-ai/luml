############################################
# Satellite Docker Compose configuration
# Copy to .env and fill in values
############################################

# Required: token issued by the platform
SATELLITE_TOKEN=replace-with-your-token

# Required: local monitoring store credentials, shared by the agent and collector
GREPTIMEDB_USERNAME=monitoring
# Generate with openssl rand -hex 32, then set this value before starting Compose
GREPTIMEDB_PASSWORD=

# Optional overrides
PLATFORM_URL=https://dev-api.luml.ai
# Public URL of this satellite (used to report inference endpoints).
# By default the bundled proxy serves plain HTTP on 127.0.0.1:80.
BASE_URL=http://localhost

# Remote access with automatic HTTPS: a DNS name that resolves to this host.
# The bundled proxy then obtains a Let's Encrypt certificate and serves port 443.
# Set all three together.
# SATELLITE_DOMAIN=sat.example.com
# PROXY_BIND=0.0.0.0
# BASE_URL=https://sat.example.com

# Image the agent will launch for deployments
MODEL_IMAGE=luml-random-svc:latest

# Polling interval in seconds
POLL_INTERVAL_SEC=2

# Telemetry: OTLP endpoint for the co-located OpenTelemetry Collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Global monitoring kill-switch (default: true)
MONITORING_ENABLED=true
