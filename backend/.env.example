# Copy to .env and replace every value. Secrets below are placeholders, not working credentials.

# Generate: openssl rand -hex 32
AUTH_SECRET_KEY=replace-with-64-hex-characters
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BUCKET_SECRET_KEY=replace-with-fernet-key
POSTGRESQL_DSN=postgresql+asyncpg://luml:luml@localhost:5432/luml_studio

# Google sign-in (Google Cloud Console, OAuth client)
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-replace-with-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback

# Microsoft sign-in (Entra app registration, see README "Microsoft OAuth")
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=replace-with-client-secret
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/v1/auth/microsoft/callback

# Links used in emails
CONFIRM_EMAIL_REDIRECT_URL=http://localhost:5173/email-confirmed
CONFIRM_EMAIL_URL=http://localhost:8000/v1/auth/confirm-email?confirmation_token=
CHANGE_PASSWORD_URL=http://localhost:5173/change-password?token=
APP_EMAIL_URL=http://localhost:5173/

# SendGrid
SENDGRID_API_KEY=SG.replace-with-sendgrid-api-key
SENDER_EMAIL=no-reply@example.com
TEMPLATE_ID_ACTIVATION_EMAIL=d-00000000000000000000000000000001
TEMPLATE_ID_RESET_PASSWORD_EMAIL=d-00000000000000000000000000000002
TEMPLATE_ID_ORGANIZATION_INVITE_EMAIL=d-00000000000000000000000000000003
TEMPLATE_ID_ADDED_TO_ORBIT_EMAIL=d-00000000000000000000000000000004

# Optional: cookies and CORS (set CORS_ORIGINS to the frontend origin for cross-origin setups)
AUTH_COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173

# Optional: live sessions
LIVE_SESSION_EXPOSE_TOKEN_LIFETIME_SECONDS=600
LIVE_SESSION_VIEW_TOKEN_LIFETIME_SECONDS=300
LIVE_SESSION_RELAY_TOKEN_OVERLAP_SECONDS=600
LIVE_SESSION_VIEWER_IDLE_SECONDS=604800

# Optional: Logfire observability, off unless LOGFIRE_TOKEN is set (see README "Optional backend observability")
# LOGFIRE_TOKEN=pylf_v1_us_replace-with-project-write-token
LOGFIRE_ENVIRONMENT=dev
LOGFIRE_SERVICE_VERSION=0.1.0
LOGFIRE_BASE_URL=https://logfire-us.pydantic.dev

# Optional: platform admin, off unless PLATFORM_ADMIN_EMAIL is set
# PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_AUTH_METHODS=GOOGLE
PLATFORM_ADMIN_GOOGLE_REDIRECT_URI=http://localhost:8000/v1/platform-admin/auth/google/callback
PLATFORM_ADMIN_GOOGLE_HOSTED_DOMAIN=example.com
PLATFORM_ADMIN_TOKEN_EXPIRE=3600
