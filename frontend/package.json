{
  "name": "@luml/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "type-check:tests": "vue-tsc -p tsconfig.stack.json && vue-tsc -p tsconfig.integration.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest",
    "test:ci": "vitest run --environment jsdom",
    "test:ui": "vitest --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:integration": "playwright test",
    "test:integration:ui": "playwright test --ui",
    "test:integration:report": "playwright show-report"
  },
  "dependencies": {
    "@fnnx-ai/common": "^0.0.1",
    "@fnnx-ai/web": "^0.0.2",
    "@luml/attachments": "*",
    "@luml/design-tokens": "*",
    "@luml/experiments": "*",
    "@primevue/forms": "^4.3.9",
    "@primevue/themes": "^4.3.9",
    "@scalar/api-reference": "^1.76.0",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/core": "^1.42.1",
    "@vueuse/components": "^12.7.0",
    "@vueuse/core": "^14.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "apache-arrow": "^21.1.0",
    "apexcharts": "^5.10.6",
    "arquero": "^7.2.0",
    "axios": "^1.20.0",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.17",
    "file-saver": "^2.0.5",
    "github-markdown-css": "^5.8.1",
    "idb": "^8.0.3",
    "js-yaml": "^5.4.1",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^0.460.0",
    "marked": "^17.0.0",
    "mock-json-schema": "^1.1.2",
    "parquet-wasm": "^0.7.1",
    "pinia": "^2.2.6",
    "plotly.js-basic-dist-min": "^3.5.0",
    "primevue": "^4.4.1",
    "qs": "^6.17.0",
    "uuid": "^14.0.3",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "vue3-apexcharts": "^1.8.0",
    "vuedraggable": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.52",
    "@types/file-saver": "^2.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/qs": "^6.14.0",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.7",
    "patch-package": "^8.0.1"
  }
}
