{
  "name": "@luml/attachments",
  "version": "0.1.1",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build && vite build --mode browser-global",
    "type-check": "vue-tsc --build",
    "test": "vitest --environment jsdom",
    "test:ci": "npm run build-only && node --test ../../tests/package.test.mjs ../../tests/attachment-browser.test.mjs && vitest run --environment jsdom",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "format:check": "prettier --check --experimental-cli src/",
    "style": "npx style-dictionary build --config style-dictionary.config.mjs"
  },
  "devDependencies": {
    "@fnnx-ai/common": "^0.0.1",
    "@fnnx-ai/web": "^0.0.2",
    "@primevue/forms": "^4.5.4",
    "@tsconfig/node22": "^22.0.5",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^24.10.4",
    "@types/sql.js": "^1.4.9",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/tsconfig": "^0.8.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.7.4",
    "style-dictionary": "^5.4.4",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.2.2"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/luml-attachments.umd.js",
  "module": "./dist/luml-attachments.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/luml-attachments.es.js",
      "require": "./dist/luml-attachments.umd.js"
    },
    "./style.css": "./dist/attachments.css"
  },
  "peerDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@primevue/themes": "^4.3.9",
    "apache-arrow": "21.1.0",
    "arquero": "^7.2.0",
    "dompurify": "^3.4.17",
    "github-markdown-css": "^5.8.1",
    "hyparquet": "^1.33.1",
    "hyparquet-compressors": "^1.1.3",
    "js-yaml": "^5.4.1",
    "jsonc-parser": "^3.3.1",
    "lucide-vue-next": "^0.460.0",
    "marked": "^17.0.0",
    "pinia": "^2.2.6",
    "primevue": "^4.4.1",
    "vue": "^3.5.12"
  },
  "dependencies": {
    "@uwdata/flechette": "^2.8.1",
    "fzstd": "^0.1.1",
    "lz4js": "^0.2.0",
    "yaml": "^2.9.1"
  }
}
